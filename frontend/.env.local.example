# Copy to `frontend/.env.local`.
#
#   Windows (PowerShell):  Copy-Item frontend\.env.local.example frontend\.env.local
#   Windows (cmd):         copy frontend\.env.local.example frontend\.env.local
#   macOS / Linux:         cp frontend/.env.local.example frontend/.env.local
#
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time.
# Only ever put non-secret values here. The Razorpay *secret* lives exclusively
# in backend/.env and never reaches the client.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
