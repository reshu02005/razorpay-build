# ---------------------------------------------------------------------------
# RecoverAI backend configuration
#
# Copy this file to `backend/.env` and fill in whatever you have.
#
#   Windows (PowerShell):  Copy-Item backend\.env.example backend\.env
#   Windows (cmd):         copy backend\.env.example backend\.env
#   macOS / Linux:         cp backend/.env.example backend/.env
#
# EVERY VALUE BELOW IS OPTIONAL. With an empty .env the app still runs:
#   * no GEMINI_API_KEY   -> deterministic rule-based planner (UI shows "Rule-based")
#   * no RAZORPAY_* keys  -> in-process simulated gateway (UI shows "Simulated")
# Both degraded modes are labelled in the interface, never hidden.
# ---------------------------------------------------------------------------

# --- Application ---------------------------------------------------------
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
FRONTEND_BASE_URL=http://localhost:3000

# --- Google Gemini -------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Razorpay TEST MODE only ---------------------------------------------
# Dashboard -> Settings -> API Keys, with the Test/Live switch set to TEST.
# A key beginning with `rzp_live_` is rejected at start-up on purpose: this
# project must never be pointed at real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you expose a public webhook URL (e.g. via ngrok).
# Without it the webhook endpoint REJECTS every delivery, which is deliberate:
# that endpoint creates payments and customers, so an unauthenticated one lets
# anybody put rows into the merchant's approval queue.
RAZORPAY_WEBHOOK_SECRET=

# Accept unsigned webhook deliveries. Local development only -- never set this
# on anything reachable from the internet. It exists so a Razorpay dashboard
# test event can be ingested without configuring a secret first.
# ALLOW_UNSIGNED_WEBHOOKS=false

# --- Guardrail policy ----------------------------------------------------
# Uncomment to override. Documented in docs/03-GUARDRAILS.md.
# All money values are in PAISE (100 paise = 1 rupee).
# MAX_RECOVERY_ATTEMPTS=2
# RECOVERY_COOLDOWN_SECONDS=900
# HIGH_VALUE_REVIEW_THRESHOLD_PAISE=1000000
# MAX_RECOVERY_AMOUNT_PAISE=5000000
# DAILY_RECOVERY_BUDGET_PAISE=20000000
# MAX_CASES_PER_CUSTOMER_PER_DAY=3
# MIN_PROPENSITY_SCORE=0.15
# MAX_PAYMENT_AGE_HOURS=168
# REQUIRE_HUMAN_APPROVAL=true
# AUTO_APPROVE_ENABLED=false
